---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const characters = await getCollection('characters');
---

<Layout title="The Hand Universe">
  <main class="max-w-6xl mx-auto px-6 py-24">
    <header class="text-center mb-20">
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-gray-100 to-gray-500 mb-6">
        The Hand Universe
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        Explore the lore, the emperors, and the primordial entities of a universe built on the edge of extinction.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {characters.map(char => {
        // Theme specific styling for cards
        const borderColors = {
          gold: 'border-yellow-600/30 hover:border-yellow-500/80 shadow-yellow-900/20',
          blood: 'border-red-900/30 hover:border-red-600/80 shadow-red-900/20',
          cosmic: 'border-blue-900/30 hover:border-blue-500/80 shadow-blue-900/20',
          light: 'border-white/10 hover:border-white/30 shadow-white/5'
        };

        const bgColors = {
          gold: 'bg-black/40',
          blood: 'bg-black/60',
          cosmic: 'bg-black/50',
          light: 'bg-black/30'
        };

        const textColors = {
          gold: 'text-yellow-500',
          blood: 'text-red-500',
          cosmic: 'text-blue-400',
          light: 'text-white'
        };

        const themeColor = char.data.theme as keyof typeof textColors;
        
        return (
          <a href={`/character/${char.id}`} class="group relative block outline-none">
            <div class={`absolute inset-0 bg-gradient-to-b from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl pointer-events-none`} />
            
            <article class={`tilt-card block h-full p-8 rounded-2xl border transition-all duration-500 group shadow-lg hover:shadow-2xl ${borderColors[themeColor]} ${bgColors[themeColor]}`} style="transform-style: preserve-3d; transition: transform 0.1s ease, box-shadow 0.5s ease;">
            
            <div class="flex justify-between items-start mb-6" style="transform: translateZ(20px);">
              <span class={`text-xs font-bold tracking-widest uppercase border border-white/10 px-3 py-1 rounded-full ${textColors[themeColor as keyof typeof textColors]}`}>
                {char.data.race}
              </span>
              <span class="text-xs tracking-widest text-gray-500 uppercase">{char.data.status}</span>
            </div>
            
            <h2 transition:name={`title-${char.id}`} class={`text-3xl font-bold mb-2 group-hover:scale-105 transform origin-left transition-transform duration-500 ${textColors[themeColor as keyof typeof textColors]}`} style="transform: translateZ(30px);">
              {char.data.name}
            </h2>
            
            <h3 class="text-lg text-gray-400 font-light mb-6" style="transform: translateZ(25px);">
              {char.data.title}
            </h3>
              
              <p class="text-sm text-gray-400 italic border-l-2 border-gray-700 pl-4">
                "{char.data.quote}"
              </p>
              
              <div class="mt-8 flex items-center text-sm font-medium text-gray-400 group-hover:text-white transition-colors">
                Read Profile
                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>
            </article>
          </a>
        );
      })}
    </div>
  </main>
</Layout>

---
// src/components/ImageViewer.astro
interface Props {
  src: string;
  alt: string;
  caption?: string;
  id?: string;
}

const { src, alt, caption, id = Math.random().toString(36).substr(2, 9) } = Astro.props;
---

<div class="image-viewer-container my-8 max-w-2xl mx-auto">
  <button onclick={`document.getElementById('dialog-${id}').showModal()`} class="w-full relative group overflow-hidden rounded-xl border border-white/10 bg-black/50 cursor-zoom-in block">
    <img src={src} alt={alt} class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700 opacity-80 group-hover:opacity-100" />
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-black/40">
      <svg class="w-12 h-12 text-white/70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
      </svg>
    </div>
  </button>
  {caption && <p class="text-sm text-center text-gray-500 mt-3 font-serif tracking-widest">{caption}</p>}
  
  <dialog id={`dialog-${id}`} class="bg-transparent m-auto p-0 backdrop:bg-black/95 backdrop:backdrop-blur-md w-full max-w-6xl h-full max-h-screen outline-none open:flex flex-col items-center justify-center fixed inset-0 z-[100]" onclick="if (event.target === this) this.close()">
    <div class="relative w-full h-full flex flex-col items-center justify-center p-4">
      <button onclick={`document.getElementById('dialog-${id}').close()`} class="absolute top-6 right-6 text-white/50 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-full p-3 transition-all z-50">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img src={src} alt={alt} class="max-w-full max-h-[90vh] object-contain rounded-lg shadow-2xl border border-white/10" />
    </div>
  </dialog>
</div>

<style>
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(8px);
  }
</style>
